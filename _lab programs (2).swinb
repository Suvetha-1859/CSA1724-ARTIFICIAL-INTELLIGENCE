<div class="notebook">

<div class="nb-cell program" name="p1">
% Initial facts
fact(parent(alice, bob)).
fact(parent(bob, carol)).
fact(parent(carol, david)).

% Rule descriptions
rule(ancestor(X, Y), [parent(X, Y)]).
rule(ancestor(X, Y), [parent(X, Z), ancestor(Z, Y)]).

% Start forward chaining
forward_chain :-
    findall(F, fact(F), Facts),
    derive_until_stable(Facts, AllFacts),
    assert_new_facts(AllFacts).

% Keep deriving facts until no more can be added
derive_until_stable(Facts, FinalFacts) :-
    findall(NewFact,
        ( rule(NewFact, Conditions),
          conditions_true(Conditions, Facts),
          \+ member(NewFact, Facts)
        ),
        Candidates),
    sort(Candidates, NewFacts),
    ( NewFacts = [] -&gt;
        FinalFacts = Facts
    ;
        append(Facts, NewFacts, UpdatedFacts),
        derive_until_stable(UpdatedFacts, FinalFacts)
    ).

% Check whether all rule conditions are known
conditions_true([], _).
conditions_true([Condition | Rest], Facts) :-
    member(Condition, Facts),
    conditions_true(Rest, Facts).

% Add the derived facts to Prolog's database
assert_new_facts([]).
assert_new_facts([Fact | Rest]) :-
    ( fact(Fact) -&gt; true ; assertz(fact(Fact)) ),
    assert_new_facts(Rest).
</div>

</div>
